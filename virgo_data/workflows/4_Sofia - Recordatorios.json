    {
      "parameters": {
        "jsCode": "const resultados = [];\nconst eventos = $input.all();\nconst eventosProcesados = new Set(); \n\nlet todosLosReclutadores = [];\ntry {\n    todosLosReclutadores = $('CargarReclutadores').all().map(r => r.json);\n} catch(e) {}\n\nfor (let i = 0; i < eventos.length; i++) {\n    const evento = eventos[i].json;\n    \n    if (!evento.id || eventosProcesados.has(evento.id)) continue;\n    eventosProcesados.add(evento.id);\n\n    const descripcion = evento.description || '';\n    \n    // 🔎 BUSCAMOS EL TELÉFONO (Filtro de seguridad)\n    const telMatch = descripcion.match(/Tel[:\\s]*([0-9]{10,13})/i);\n    const telefonoCandidato = telMatch ? telMatch[1] : null;\n\n    // 🚫 SI NO HAY TELÉFONO, NO ES UNA CITA LISTA. LA IGNORAMOS.\n    if (!telefonoCandidato) {\n        continue; \n    }\n\n    const nombreMatch = descripcion.match(/Nombre[:\\s]*([^\\n]+)/i);\n    const nombreCandidato = nombreMatch ? nombreMatch[1].trim() : 'Nombre';\n\n    let horaFormateada = 'hora por confirmar';\n    try {\n        const fechaISO = evento.start?.dateTime || evento.start?.date;\n        const fecha = new Date(fechaISO);\n        horaFormateada = fecha.toLocaleString('es-MX', {\n            timeZone: 'America/Mexico_City',\n            weekday: 'long',\n            day: 'numeric',\n            month: 'long',\n            hour: '2-digit',\n            minute: '2-digit',\n            hour12: true\n        });\n    } catch(e) {}\n\n    let nombreReclutador = 'Tu equipo';\n    let emojiReclutador = '📅';\n    let telefonoReclutador = '5213323379399';\n    let reclutadoresExtra = [];\n\n    const recData = todosLosReclutadores.find(r => \n        evento.organizer?.email === r.calendar_id || \n        evento.creator?.email === r.calendar_id ||\n        (evento.attendees && evento.attendees.some(a => a.email === r.calendar_id))\n    );\n\n    const reclutadorFinal = recData || (todosLosReclutadores.length > 0 ? todosLosReclutadores[0] : null);\n\n    if (reclutadorFinal) {\n        nombreReclutador = reclutadorFinal.nombre_reclutador || nombreReclutador;\n        emojiReclutador = reclutadorFinal.emoji || emojiReclutador;\n        telefonoReclutador = reclutadorFinal.telefono_reclutador || telefonoReclutador;\n        reclutadoresExtra = reclutadorFinal.reclutadores_extra || [];\n    }\n\n    const mensajeReclutador = `⏰ *¡RECORDATORIO DE ENTREVISTA MAÑANA!* ${emojiReclutador}\\n\\nHola ${nombreReclutador}, tienes una cita programada:\\n\\n👤 *Candidato:* ${nombreCandidato}\\n📱 *Tel:* wa.me/${telefonoCandidato}\\n🕒 *Cuando:* ${horaFormateada}\\n\\n📝 _Evento: ${evento.summary || 'Entrevista'}_`;\n\n    const mensajeCandidato = `Hola ${nombreCandidato}, te recordamos que mañana tienes tu entrevista:\\n\\n🕒 ${horaFormateada}\\n\\nTe esperamos. Cualquier duda, escríbenos. ✨`;\n\n    resultados.push({\n        json: {\n            mensaje_reclutador: mensajeReclutador,\n            telefono_reclutador: telefonoReclutador,\n            mensaje_candidato: mensajeCandidato,\n            telefono_candidato: telefonoCandidato,\n            evento_valido: true,\n            reclutadores_extra: reclutadoresExtra\n        }\n    });\n}\n\nreturn resultados;"
      },
