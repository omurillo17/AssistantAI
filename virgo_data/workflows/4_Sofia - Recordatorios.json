      "id": "a234c8d0-3113-41f0-9dcf-21304a85c6d8",
      "name": "NotificarReclutador",
      "credentials": {
        "wahaApi": {
          "id": "OBarvY73V8DKtYv0",
          "name": "WAHA account"
        }
      }
