    {
      "parameters": {
        "jsCode": "const fs = require('fs');\n\n// 1. Obtenemos el resultado de GetInfo\nconst getInfoResult = $input.first().json;\nconst remitente = getInfoResult.id || \"\";\n\n// FIX WAHA: Rescatamos el LID corrupto y extraemos el número real\nif (remitente && remitente.includes(\"@\")) {\n  getInfoResult.lid = getInfoResult.number;\n  getInfoResult.number = remitente.split(\"@\")[0];\n}\n\n// 2. Lista de reclutadores desde la BD via API\nlet equipo = [];\ntry {\n    let apiBase = 'http://host.docker.internal:3000';\nlet empresaId = '';\ntry { if (typeof process !== 'undefined' && process.env && process.env.TCI_API_BASE) apiBase = process.env.TCI_API_BASE; } catch(e) {}\ntry { if (typeof $env !== 'undefined' && $env && $env.TCI_API_BASE) apiBase = $env.TCI_API_BASE; } catch(e) {}\ntry { if (typeof process !== 'undefined' && process.env && process.env.TCI_EMPRESA_ID) empresaId = process.env.TCI_EMPRESA_ID; } catch(e) {}\ntry { if (typeof $env !== 'undefined' && $env && $env.TCI_EMPRESA_ID) empresaId = $env.TCI_EMPRESA_ID; } catch(e) {}\n    const response = await fetch(apiBase + \"/api/db/reclutador_vacantes\");\n    if (response.ok) { equipo = await response.json(); }\n} catch (error) {\n    console.log(\"Error consultando reclutadores en BD:\", error.message);\n}\n\n// 3. Revisamos si el número coincide\nfor (const reclutador of equipo) {\n    if (reclutador.telefono) {\n        const diezDigitos = reclutador.telefono.trim().slice(-10);\n        if (remitente.includes(diezDigitos)) {\n            return []; // Es reclutador -> Detenemos el flujo\n        }\n    }\n}\n\nreturn [{ json: getInfoResult }];\n"
      },
