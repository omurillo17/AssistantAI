# ============================================
# ASSISTANT AI - Variables de Entorno
# Copia este archivo como .env y llena los valores
# ============================================

# --- PostgreSQL (usado por docker-compose y n8n) ---
# Genera contraseñas fuertes; NUNCA commitees los valores reales.
DB_POSTGRESDB_DATABASE=virgo_db
DB_POSTGRESDB_USER=virgo_user
DB_POSTGRESDB_PASSWORD=CAMBIA_ESTA_CONTRASENA

# --- n8n ---
WEBHOOK_URL=http://localhost:5678

# --- WAHA (WhatsApp API) ---
WAHA_API_KEY=GENERA_UNA_LLAVE_ALEATORIA
# Credenciales del dashboard de WAHA (cámbialas siempre en producción)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CAMBIA_ESTA_CONTRASENA

# Llave con la que n8n cifra sus credenciales guardadas. Genérala una sola vez
# (openssl rand -base64 24) y NUNCA la cambies después, o n8n no podrá descifrar.
N8N_ENCRYPTION_KEY=GENERA_UN_SECRETO_ALEATORIO

# --- Frontend Next.js ---
DB_HOST=localhost
DB_USER=virgo_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_NAME=virgo_db
DB_PORT=5432
DATABASE_URL=postgresql://virgo_user:CAMBIA_ESTA_CONTRASENA@localhost:5432/virgo_db

# Genera un secreto aleatorio, p. ej.: openssl rand -base64 32
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO
APP_PASSWORD=CAMBIA_ESTA_CONTRASENA
N8N_SECRET=GENERA_UN_SECRETO_ALEATORIO

# --- Multi-tenant (opcional, para n8n) ---
# OJO: el puerto 3000 lo ocupa el contenedor WAHA (ver docker-compose.yml).
# El frontend Next.js corre en el 3001 (ver frontend/package.json), por eso
# TCI_API_BASE debe apuntar ahi para que n8n consuma /api/prompt-context correctamente.
TCI_API_BASE=http://host.docker.internal:3001
TCI_EMPRESA_ID=

# Llave que n8n manda como header x-api-key al llamar endpoints server-to-server
# del frontend (/api/prompt-context, /api/cron/process-outbox). Debe coincidir
# EXACTAMENTE con la N8N_API_KEY definida en frontend/.env.local.
N8N_API_KEY=

# Protección de los webhooks del frontend (/api/webhook/*, /api/upload-cv).
# Los flujos 2 y 3 de virgo_data/workflows ya envían x-api-key = N8N_API_KEY;
# después de REIMPORTAR esos flujos en n8n, define en frontend/.env.local:
#   WEBHOOK_API_KEY=<el mismo valor que N8N_API_KEY>
# Mientras esté vacía, los webhooks aceptan llamadas sin llave (se registra
# una advertencia en los logs del frontend).
# WEBHOOK_API_KEY=
