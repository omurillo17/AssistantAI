# ============================================
# ASSISTANT AI - Variables de Entorno
# Copia este archivo como .env y llena los valores
# ============================================

# --- PostgreSQL (usado por docker-compose y n8n) ---
DB_POSTGRESDB_DATABASE=tu_nombre_db
DB_POSTGRESDB_USER=tu_usuario_db
DB_POSTGRESDB_PASSWORD=tu_password_db

# --- n8n ---
WEBHOOK_URL=http://tu-servidor:5678

# --- WAHA (WhatsApp API) ---
WAHA_API_KEY=tu_api_key_waha

# --- Frontend Next.js ---
DB_HOST=localhost
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_db
DB_NAME=tu_nombre_db
DB_PORT=5432
DATABASE_URL=postgresql://tu_usuario_db:tu_password_db@localhost:5432/tu_nombre_db

JWT_SECRET=tu_jwt_secret
APP_PASSWORD=tu_password_login
N8N_SECRET=tu_secreto_n8n

# --- Multi-tenant (opcional, para n8n) ---
TCI_API_BASE=http://host.docker.internal:3000
TCI_EMPRESA_ID=
