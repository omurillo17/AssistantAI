# ============================================
# ASSISTANT AI - Variables de Entorno
# Copia este archivo como .env y llena los valores
# ============================================

# --- PostgreSQL (usado por docker-compose) ---
# Genera contraseñas fuertes; NUNCA commitees los valores reales.
DB_POSTGRESDB_DATABASE=virgo_db
DB_POSTGRESDB_USER=virgo_user
DB_POSTGRESDB_PASSWORD=CAMBIA_ESTA_CONTRASENA

# --- WAHA (WhatsApp API) ---
WAHA_API_KEY=GENERA_UNA_LLAVE_ALEATORIA
# Credenciales del dashboard de WAHA (cámbialas siempre en producción)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CAMBIA_ESTA_CONTRASENA

# --- Frontend Next.js ---
DB_HOST=localhost
DB_USER=virgo_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_NAME=virgo_db
DB_PORT=5432
DATABASE_URL=postgresql://virgo_user:CAMBIA_ESTA_CONTRASENA@localhost:5432/virgo_db

# Genera un secreto aleatorio, p. ej.: openssl rand -base64 32
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO
APP_PASSWORD=CAMBIA_ESTA_CONTRASENA

# --- Cloudflare Tunnel ---
# Token del tunel que publica el frontend en internet con HTTPS (servicio
# cloudflared del docker-compose). Es lo UNICO expuesto al exterior: el resto
# de puertos se publican solo en 127.0.0.1. Se copia del panel de Cloudflare
# Zero Trust > Networks > Tunnels > el tunel > Install and run connector.
# Sin este valor el contenedor cloudflared arranca y muere en bucle, y la
# plataforma solo queda accesible desde el propio servidor.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Comunicacion backend -> frontend ---
# Llave que backend manda como header x-api-key en TODAS sus llamadas al
# frontend: /api/webhook/*, /api/upload-cv, /api/prompt-context, /api/cron/* y
# las lecturas server-to-server de /api/db/*. Debe existir con el MISMO valor
# en este archivo y en frontend/.env.local; si no, esos endpoints quedan sin
# autenticacion (fail-open con advertencia en los logs del frontend).
# Genera el valor con: openssl rand -base64 32
INTERNAL_API_KEY=GENERA_UN_SECRETO_ALEATORIO

# URL con la que backend llama al frontend Next.js. OJO: el puerto 3000 lo
# ocupa el contenedor WAHA (ver docker-compose.yml); el frontend corre en el
# 3001 (ver frontend/package.json). Solo cambiarla si backend corre fuera de
# Docker.
FRONTEND_API_BASE=http://host.docker.internal:3001
# Llave con la que backend cifra/descifra los refresh tokens de Google
# Calendar guardados en la tabla google_calendar_credentials. Generar UNA VEZ
# con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# y NUNCA cambiarla después, o los tokens guardados quedarán ilegibles.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Credenciales del OAuth Client (tipo "Desktop app") creado UNA VEZ en Google
# Cloud Console para todo el proyecto (habilitar la Calendar API). Los usan
# tanto backend en runtime como backend/scripts/authorize_recruiter.py.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Llave que el frontend manda como header x-api-key al llamar a backend
# (eventos-calendario, citas). Es una variable separada de INTERNAL_API_KEY:
# protege la direccion contraria (frontend -> backend), asi se puede rotar de
# forma independiente. OBLIGATORIA:
# backend falla cerrado (401 a todo) si esta variable no está configurada.
PYTHON_SERVICE_API_KEY=

# API key de Google Gemini (aistudio.google.com/apikey). Usada por
# backend/app/gemini_client.py para el análisis de CV/audio y el agente de
# chat.
GEMINI_API_KEY=

# WhatsApp del administrador (ROOT) que recibe copia de las alertas de fallo
# del agente, ademas del reclutador afectado. Solo digitos con codigo de pais.
# Si se deja vacio, solo se avisa al reclutador.
ALERTAS_ADMIN_TELEFONO=

# Ritmo de salida de WhatsApp. Con WAHA (canal no oficial) Meta banea los
# numeros que responden muchos mensajes por minuto. Separacion minima entre
# mensajes + un extra aleatorio. Poner ambos en 0 desactiva el regulador.
WAHA_SEGUNDOS_ENTRE_MENSAJES=8
WAHA_JITTER_SEGUNDOS=7

# Cola de salida (process-outbox): cuantos mensajes por ciclo y pausa entre
# ellos. El cron corre cada 2 minutos.
OUTBOX_LOTE=6
OUTBOX_PAUSA_MS=10000
